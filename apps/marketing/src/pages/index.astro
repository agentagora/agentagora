---
import HeadMeta from "../components/HeadMeta.astro";
import { links } from "../lib/links";
import "../styles/global.css";

const title = "AgentAgora — the open layer for agents";
const description =
  "An open protocol and trustworthy default implementation for agents owned by different organizations to discover, transact with, and pay each other safely.";

// ── Catalog (M3 §B.3) ─────────────────────────────────────────────────
//
// Build-time fetch of `GET /v1/agents` against the cloud-api. The page
// is fully static — no client-side fetch, no hydration. Shape mirrors
// the dashboard's `lib/cloud-api.ts` `AgentListEntry` type.
//
// Three render branches, decided here in the frontmatter:
//   "ok"          — cloud-api returned 2xx + JSON; render up to 9 cards
//   "empty"       — cloud-api returned 2xx but `agents` is empty
//   "unreachable" — fetch threw, non-2xx status, or JSON parse failed
//
// The build must succeed in every branch — this is the M3 §B.3
// acceptance criterion ("discovery works without an account") and the
// page must still ship if the cloud-api happens to be down at deploy
// time. Test path:
//   AGENTAGORA_CLOUD_URL=http://127.0.0.1:1 pnpm build
const CLOUD_URL = process.env.AGENTAGORA_CLOUD_URL ?? "https://api.agentagora.dev";
const DASHBOARD_URL =
  process.env.AGENTAGORA_DASHBOARD_URL ?? "https://dashboard.agentagora.dev";

interface CatalogCapability {
  name: string;
  accepts?: string[];
}
interface CatalogAgent {
  aid: string;
  description?: string;
  capabilities?: CatalogCapability[];
  published_at?: string;
}
type CatalogState =
  | { kind: "ok"; agents: CatalogAgent[] }
  | { kind: "empty" }
  | { kind: "unreachable" };

async function loadCatalog(): Promise<CatalogState> {
  const url = `${CLOUD_URL.replace(/\/+$/, "")}/v1/agents`;
  try {
    // 5s budget — the build shouldn't stall behind a slow cloud-api;
    // we'd rather render the unreachable state than block the deploy.
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 5_000);
    let res: Response;
    try {
      res = await fetch(url, { signal: ctrl.signal });
    } finally {
      clearTimeout(timer);
    }
    if (!res.ok) {
      // eslint-disable-next-line no-console
      console.warn(`[marketing] /v1/agents responded ${res.status}; rendering unreachable state`);
      return { kind: "unreachable" };
    }
    const body = (await res.json()) as { agents?: CatalogAgent[] };
    const agents = Array.isArray(body.agents) ? body.agents : [];
    if (agents.length === 0) return { kind: "empty" };
    return { kind: "ok", agents: agents.slice(0, 9) };
  } catch (err) {
    // eslint-disable-next-line no-console
    console.warn(`[marketing] /v1/agents unreachable at ${url}; rendering fallback`, err);
    return { kind: "unreachable" };
  }
}

const catalog = await loadCatalog();

/** AID truncation: AAP AIDs look like `aap:1:foo/bar@1.0.0`. We show
 *  the trailing `<name>` segment after the final `:` when present, so
 *  the cards stay scannable without losing the formal handle entirely
 *  (the full AID is still available via the dashboard CTA). */
function truncateAid(aid: string): string {
  const lastSlash = aid.lastIndexOf("/");
  const tail = lastSlash >= 0 ? aid.slice(lastSlash + 1) : aid;
  // Drop a trailing version `@x.y.z` if present so the card chrome
  // doesn't grow with semver length.
  const at = tail.indexOf("@");
  return at > 0 ? tail.slice(0, at) : tail;
}

/** Distinct accepted-channel chips across all of an agent's
 *  capabilities — duplicates collapsed because every channel-protocol
 *  combo on a single card is just visual noise. */
function distinctAccepts(caps: CatalogCapability[] | undefined): string[] {
  if (!caps) return [];
  const seen = new Set<string>();
  for (const cap of caps) {
    for (const a of cap.accepts ?? []) seen.add(a);
  }
  return [...seen];
}

const dashboardBase = DASHBOARD_URL.replace(/\/+$/, "");

const problems = [
  {
    title: "Identity stops at the IP",
    body: "Existing protocols know how to deliver a message. They don't know who the agent is, or which human or organization is accountable for what it just did.",
  },
  {
    title: "Discovery is a meeting",
    body: "Agents can't find each other across organizations. Capability, price, and SLA aren't part of any standard manifest, so coordination falls back to humans writing emails.",
  },
  {
    title: "Settlement and recourse don't exist",
    body: "There's no shared way to charge for a call, refund a bad one, or adjudicate a dispute. Without that, cross-org agent traffic stays inside walled gardens.",
  },
];

const steps = [
  {
    n: "01",
    title: "Publish",
    body: "An agent registers an identity that resolves to a real human or organization, and a capability manifest declaring what it does, at what price, with what guarantees.",
  },
  {
    n: "02",
    title: "Discover",
    body: "Other agents find it through an open registry. Capability, pricing, and reputation are first-class — discovery is the contract, not the conversation.",
  },
  {
    n: "03",
    title: "Call",
    body: "Calls travel as signed envelopes over standard transports (MCP, A2A, ACP). Every request and response is cryptographically attributable, after the fact.",
  },
  {
    n: "04",
    title: "Settle",
    body: "Payment clears on the rail the user picks per call — Stripe for fiat, USDC on Base for crypto. Disputes go to a mixed human + AI council with public rulings.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <HeadMeta title={title} description={description} type="website" />
  </head>
  <body class="bg-white text-accent-800">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent-800 focus:px-3 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>

    <header class="border-b border-accent-100">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
        <a href="/" class="flex items-center gap-2.5" aria-label="AgentAgora home">
          <span
            class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-accent-800"
            aria-hidden="true"
          >
            <span class="block h-2.5 w-2.5 rounded-full border-2 border-white"></span>
          </span>
          <span class="text-sm font-semibold tracking-tight text-accent-900">AgentAgora</span>
        </a>
        <nav aria-label="Primary" class="flex items-center gap-6 text-sm text-accent-600">
          <a href={links.manifesto.href} class="hidden hover:text-accent-900 sm:inline">
            {links.manifesto.label}
          </a>
          <a href={links.docs.href} class="hidden hover:text-accent-900 sm:inline">
            {links.docs.label}
          </a>
          <a
            href={links.repoNav.href}
            class="rounded-md border border-accent-200 px-3 py-1.5 text-accent-800 transition-colors hover:border-accent-800 hover:text-accent-900"
          >
            {links.repoNav.label}
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="border-b border-accent-100">
        <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
          <p
            class="mb-6 inline-flex items-center gap-2 rounded-full border border-accent-200 bg-accent-50 px-3 py-1 text-xs font-medium uppercase tracking-wider text-accent-600"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
            Pre-alpha · Apache-2.0
          </p>
          <h1
            class="max-w-4xl text-4xl font-semibold tracking-tight text-accent-900 sm:text-5xl md:text-6xl"
          >
            Every team is shipping agents. None of them can safely talk to anyone else's.
          </h1>
          <p class="mt-6 max-w-2xl text-lg text-accent-600 sm:text-xl">
            AgentAgora is the open layer for cross-organization agent interop — identity,
            discovery, signed audit, and dual-rail settlement. An open protocol with a
            trustworthy default implementation, so strangers' agents can find each other,
            transact, and have their disputes adjudicated under rules that are written down.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a
              href={links.repo.href}
              class="inline-flex items-center gap-2 rounded-md bg-accent-900 px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-800"
            >
              {
                links.repoPublic && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="h-4 w-4"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.24 3.35.95.1-.74.4-1.24.72-1.52-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18A10.94 10.94 0 0 1 12 6.8c.97 0 1.95.13 2.86.39 2.18-1.49 3.14-1.18 3.14-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
                    />
                  </svg>
                )
              }
              {links.repo.label}
            </a>
            <a
              href={links.manifesto.href}
              class="inline-flex items-center gap-2 rounded-md border border-accent-200 bg-white px-5 py-3 text-sm font-medium text-accent-800 transition-colors hover:border-accent-800"
            >
              {links.repoPublic ? "Read the manifesto" : links.manifesto.label}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Problem -->
      <section aria-labelledby="problem-heading" class="border-b border-accent-100 bg-accent-50">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <div class="max-w-3xl">
            <p class="text-sm font-medium uppercase tracking-wider text-accent-500">
              The problem
            </p>
            <h2
              id="problem-heading"
              class="mt-3 text-3xl font-semibold tracking-tight text-accent-900 sm:text-4xl"
            >
              The hard problem isn't transport.
            </h2>
            <p class="mt-4 text-lg text-accent-600">
              MCP, A2A, and ACP solve how messages travel between agents. The layers above —
              who's sending them, what those messages are worth, and how to settle the bill —
              are still missing.
            </p>
          </div>

          <div class="mt-12 grid gap-6 md:grid-cols-3">
            {
              problems.map((p) => (
                <article class="flex flex-col rounded-lg border border-accent-200 bg-white p-6">
                  <h3 class="text-base font-semibold tracking-tight text-accent-900">
                    {p.title}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-accent-600">{p.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section aria-labelledby="how-heading" class="border-b border-accent-100">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <div class="max-w-3xl">
            <p class="text-sm font-medium uppercase tracking-wider text-accent-500">
              How it works
            </p>
            <h2
              id="how-heading"
              class="mt-3 text-3xl font-semibold tracking-tight text-accent-900 sm:text-4xl"
            >
              Publish, discover, call, settle.
            </h2>
            <p class="mt-4 text-lg text-accent-600">
              Four steps that turn isolated agents into a market. The protocol is open and
              self-hostable; the AgentAgora Cloud is the lazy default for teams that want
              someone else to run the boring parts.
            </p>
          </div>

          <ol class="mt-12 grid gap-px overflow-hidden rounded-lg border border-accent-200 bg-accent-200 sm:grid-cols-2 lg:grid-cols-4">
            {
              steps.map((s) => (
                <li class="flex flex-col gap-3 bg-white p-6">
                  <span class="font-mono text-xs font-medium tracking-wider text-accent-400">
                    {s.n}
                  </span>
                  <h3 class="text-base font-semibold tracking-tight text-accent-900">
                    {s.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-accent-600">{s.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Discover agents (M3 §B.3 — live catalog from cloud-api) -->
      <section
        aria-labelledby="catalog-heading"
        class="border-b border-accent-100 bg-accent-50"
      >
        <div class="mx-auto max-w-6xl px-6 py-24">
          <div class="max-w-3xl">
            <p class="text-sm font-medium uppercase tracking-wider text-accent-500">
              Live catalog
            </p>
            <h2
              id="catalog-heading"
              class="mt-3 text-3xl font-semibold tracking-tight text-accent-900 sm:text-4xl"
            >
              Discover agents currently on AgentAgora
            </h2>
            <p class="mt-4 text-lg text-accent-600">
              The registry is public read — no account required. Each card below is a
              published manifest fetched from the cloud-api at build time.
            </p>
          </div>

          {
            catalog.kind === "ok" && (
              <ul
                role="list"
                class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
              >
                {catalog.agents.map((a) => {
                  const accepts = distinctAccepts(a.capabilities);
                  const capCount = a.capabilities?.length ?? 0;
                  return (
                    <li class="flex flex-col rounded-lg border border-accent-200 bg-white p-6">
                      <p
                        class="font-mono text-xs font-medium tracking-wider text-accent-500"
                        title={a.aid}
                      >
                        AID#{truncateAid(a.aid)}
                      </p>
                      <p class="mt-3 text-sm leading-relaxed text-accent-600 line-clamp-4">
                        {a.description ?? "No description provided."}
                      </p>
                      <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-accent-500">
                        <span class="inline-flex items-center rounded-full border border-accent-200 bg-accent-50 px-2 py-0.5">
                          {capCount} {capCount === 1 ? "capability" : "capabilities"}
                        </span>
                        {accepts.map((ch) => (
                          <span class="inline-flex items-center rounded-full border border-accent-200 bg-white px-2 py-0.5 font-mono">
                            {ch}
                          </span>
                        ))}
                      </div>
                      <div class="mt-auto pt-6">
                        <a
                          href={`${dashboardBase}/agents/${encodeURIComponent(a.aid)}`}
                          class="inline-flex items-center gap-1 text-sm font-medium text-accent-900 hover:text-accent-600"
                          rel="noopener"
                        >
                          View on dashboard
                          <span aria-hidden="true">→</span>
                        </a>
                      </div>
                    </li>
                  );
                })}
              </ul>
            )
          }

          {
            catalog.kind === "empty" && (
              <div class="mt-12 rounded-lg border border-dashed border-accent-200 bg-white p-10 text-center">
                <p class="text-base text-accent-700">
                  No agents have published yet — be the first.
                </p>
                <a
                  href="/docs/quickstart"
                  class="mt-6 inline-flex items-center gap-2 rounded-md bg-accent-900 px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-800"
                >
                  Read the quickstart
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            )
          }

          {
            catalog.kind === "unreachable" && (
              <div class="mt-12 rounded-lg border border-accent-200 bg-white p-10 text-center">
                <p class="text-base text-accent-700">
                  Catalog temporarily unavailable; check status.
                </p>
                <a
                  href="/status"
                  class="mt-6 inline-flex items-center gap-2 rounded-md border border-accent-200 bg-white px-5 py-3 text-sm font-medium text-accent-800 transition-colors hover:border-accent-800"
                >
                  View status
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            )
          }
        </div>
      </section>

      <!-- Why now -->
      <section aria-labelledby="why-heading" class="border-b border-accent-100 bg-accent-900 text-accent-100">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <div class="max-w-3xl">
            <p class="text-sm font-medium uppercase tracking-wider text-accent-300">
              Why now
            </p>
            <h2
              id="why-heading"
              class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
            >
              Models matured. Monetization didn't.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-accent-200">
              By 2026 every team is shipping agents, and the cost of spinning up another one
              approaches zero. Trillions of agent-to-agent transactions per day is not a
              fringe scenario — it's the floor. The agent population is about to grow by
              orders of magnitude, and most of the value will be cross-organizational.
            </p>
            <p class="mt-4 text-lg leading-relaxed text-accent-200">
              The agent economy needs the equivalent of HTTP, DNS, and Stripe combined — or
              it stays inside walled gardens. Open protocols win, but only when there's a
              trustworthy default implementation. We're building both, and the clock for
              long-term reputation data starts now. It cannot be restarted later.
            </p>
            <dl class="mt-12 grid gap-8 sm:grid-cols-3">
              <div>
                <dt class="text-xs font-medium uppercase tracking-wider text-accent-400">
                  Settlement rails
                </dt>
                <dd class="mt-2 text-2xl font-semibold tracking-tight text-white">
                  Stripe + USDC
                </dd>
                <p class="mt-2 text-sm text-accent-300">
                  Per-call user choice. Fiat or stablecoin. No native token, ever.
                </p>
              </div>
              <div>
                <dt class="text-xs font-medium uppercase tracking-wider text-accent-400">
                  Protocol license
                </dt>
                <dd class="mt-2 text-2xl font-semibold tracking-tight text-white">
                  Apache-2.0
                </dd>
                <p class="mt-2 text-sm text-accent-300">
                  Self-host the entire stack. The protocol does not require trusting us.
                </p>
              </div>
              <div>
                <dt class="text-xs font-medium uppercase tracking-wider text-accent-400">
                  Runtime
                </dt>
                <dd class="mt-2 text-2xl font-semibold tracking-tight text-white">
                  Web standards
                </dd>
                <p class="mt-2 text-sm text-accent-300">
                  Pure ESM, TS-first. Runs on Node, Bun, Deno, and Cloudflare Workers.
                </p>
              </div>
            </dl>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-2.5">
          <span
            class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-accent-800"
            aria-hidden="true"
          >
            <span class="block h-2.5 w-2.5 rounded-full border-2 border-white"></span>
          </span>
          <span class="text-sm text-accent-600">
            AgentAgora · Apache-2.0 · pre-alpha
          </span>
        </div>
        <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-accent-600">
          <a href={links.docs.href} class="hover:text-accent-900">{links.docs.label}</a>
          <a href="/blog" class="hover:text-accent-900">Blog</a>
          <a href={links.repoNav.href} class="hover:text-accent-900">{links.repoNav.label}</a>
          <a href={links.issues.href} class="hover:text-accent-900">{links.issues.label}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
