---
import HeadMeta from "../../components/HeadMeta.astro";
import { links } from "../../lib/links";
import "../../styles/global.css";
import { getCollection, type CollectionEntry } from "astro:content";

const title = "Blog — AgentAgora";
const description =
  "Updates from the AgentAgora team — launches, design notes, and protocol changes.";

type BlogEntry = CollectionEntry<"blog">;

const posts = (await getCollection("blog")).sort(
  (a: BlogEntry, b: BlogEntry) => {
    // pubDate is a string; placeholder values like "2026-05-XX" parse to NaN.
    // Fall back to lexicographic comparison so ordering is stable even with placeholders.
    const ta = Date.parse(a.data.pubDate);
    const tb = Date.parse(b.data.pubDate);
    if (Number.isNaN(ta) && Number.isNaN(tb)) {
      return b.data.pubDate.localeCompare(a.data.pubDate);
    }
    if (Number.isNaN(ta)) return 1;
    if (Number.isNaN(tb)) return -1;
    return tb - ta;
  },
);

function formatDate(raw: string): { display: string; iso: string | null } {
  const t = Date.parse(raw);
  if (Number.isNaN(t)) {
    return { display: raw, iso: null };
  }
  const d = new Date(t);
  return {
    display: d.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }),
    iso: d.toISOString().slice(0, 10),
  };
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <HeadMeta title={title} description={description} type="website" />
  </head>
  <body class="bg-white text-accent-800">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent-800 focus:px-3 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>

    <header class="border-b border-accent-100">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
        <a href="/" class="flex items-center gap-2.5" aria-label="AgentAgora home">
          <span
            class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-accent-800"
            aria-hidden="true"
          >
            <span class="block h-2.5 w-2.5 rounded-full border-2 border-white"></span>
          </span>
          <span class="text-sm font-semibold tracking-tight text-accent-900">AgentAgora</span>
        </a>
        <nav aria-label="Primary" class="flex items-center gap-6 text-sm text-accent-600">
          <a href="/blog" class="hidden text-accent-900 sm:inline">Blog</a>
          <a href={links.docs.href} class="hidden hover:text-accent-900 sm:inline">
            {links.docs.label}
          </a>
          <a
            href={links.repoNav.href}
            class="rounded-md border border-accent-200 px-3 py-1.5 text-accent-800 transition-colors hover:border-accent-800 hover:text-accent-900"
          >
            {links.repoNav.label}
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="border-b border-accent-100">
        <div class="mx-auto max-w-4xl px-6 py-20 sm:py-24">
          <p class="text-sm font-medium uppercase tracking-wider text-accent-500">Blog</p>
          <h1
            class="mt-3 text-4xl font-semibold tracking-tight text-accent-900 sm:text-5xl"
          >
            Notes from building AgentAgora.
          </h1>
          <p class="mt-4 max-w-2xl text-lg text-accent-600">
            Launches, design decisions, and changes to the protocol — written by the people
            shipping it.
          </p>
        </div>
      </section>

      <section>
        <div class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
          {
            posts.length === 0 ? (
              <p class="text-base text-accent-600">
                No posts yet. Check back soon.
              </p>
            ) : (
              <ul class="flex flex-col gap-12">
                {posts.map((post) => {
                  const { display, iso } = formatDate(post.data.pubDate);
                  return (
                    <li>
                      <article class="flex flex-col gap-3">
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-accent-500">
                          {iso ? (
                            <time datetime={iso}>{display}</time>
                          ) : (
                            <time>{display}</time>
                          )}
                          <span aria-hidden="true">·</span>
                          <span>{post.data.author}</span>
                        </div>
                        <h2 class="text-2xl font-semibold tracking-tight text-accent-900 sm:text-3xl">
                          <a
                            href={`/blog/${post.slug}`}
                            class="transition-colors hover:text-accent-700"
                          >
                            {post.data.title}
                          </a>
                        </h2>
                        <p class="text-base leading-relaxed text-accent-600">
                          {post.data.description}
                        </p>
                        {post.data.tags.length > 0 && (
                          <ul class="mt-1 flex flex-wrap gap-2" aria-label="Tags">
                            {post.data.tags.map((tag) => (
                              <li class="rounded-full border border-accent-200 bg-accent-50 px-2.5 py-0.5 text-xs font-medium text-accent-600">
                                {tag}
                              </li>
                            ))}
                          </ul>
                        )}
                      </article>
                    </li>
                  );
                })}
              </ul>
            )
          }
        </div>
      </section>
    </main>

    <footer class="bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-2.5">
          <span
            class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-accent-800"
            aria-hidden="true"
          >
            <span class="block h-2.5 w-2.5 rounded-full border-2 border-white"></span>
          </span>
          <span class="text-sm text-accent-600">
            AgentAgora · Apache-2.0 · pre-alpha
          </span>
        </div>
        <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-accent-600">
          <a href={links.docs.href} class="hover:text-accent-900">{links.docs.label}</a>
          <a href="/blog" class="hover:text-accent-900">Blog</a>
          <a href={links.repoNav.href} class="hover:text-accent-900">{links.repoNav.label}</a>
          <a href={links.issues.href} class="hover:text-accent-900">{links.issues.label}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
