{
  "name": "@agentagora/docs",
  "version": "0.0.0",
  "private": true,
  "description": "AgentAgora documentation site (VitePress).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm typedoc && vitepress dev .",
    "build": "pnpm typedoc && vitepress build .",
    "preview": "vitepress preview .",
    "typecheck": "tsc --noEmit",
    "typedoc": "typedoc --options ./typedoc.config.json"
  },
  "devDependencies": {
    "@agentagora/sdk": "workspace:*",
    "@types/node": "^24.0.0",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.4.1",
    "typescript": "^5.9.0",
    "vitepress": "^1.5.0"
  }
}
