    "hono": "^4.6.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.0.0"
  }
}
