{
  "name": "@agentagora/cloud-api",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "AgentAgora Cloud Platform API — registry, identity issuance, settlement coordination, dispute intake. Deployed on Cloudflare Workers.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx bench/bench.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@agentagora/protocol": "workspace:*",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.7.0",
    "canonicalize": "^2.0.0",
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.0.0"
  }
}
