# Example local-dev environment for @agentagora/cloud-dashboard.
#
# Next.js reads `.env.local` automatically (gitignored). Copy this
# example as the starting point:
#
#   cp apps/cloud/dashboard/.env.example apps/cloud/dashboard/.env.local
#
# Then fill in the values below. For end-to-end localhost runbook see
# docs/local-dev.md.

# Where the dashboard reaches cloud-api. In local dev, point this at
# `wrangler dev` (default port 8787). 127.0.0.1 is preferred over
# `localhost` because Node binds IPv4 by default and some setups have
# `localhost` resolving to IPv6 only.
AGENTAGORA_CLOUD_URL="http://127.0.0.1:8787"

# 48-byte base64 secret used to encrypt the AES-256-GCM session cookie.
# Generate one:
#   node -e 'console.log(crypto.randomBytes(48).toString("base64"))'
DASHBOARD_COOKIE_SECRET=""

# Optional: set to "production" to switch the cookie name to the
# `__Host-` prefix and require HTTPS. Leave unset for local dev so
# the cookie works over http://localhost:3000.
# NODE_ENV="production"
