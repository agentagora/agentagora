{
  "name": "@agentagora/protocol-compliance",
  "version": "0.0.1",
  "description": "Conformance test suite for AgentAgora Protocol (AAP) — runnable against any cloud-api candidate URL via AAP_BASE_URL env var.",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentagora/agentagora.git",
    "directory": "packages/protocol-compliance"
  },
  "type": "module",
  "bin": {
    "protocol-compliance": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "compliance:setup": "tsx src/cli.ts"
  },
  "dependencies": {
    "@agentagora/protocol": "workspace:*",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.7.0",
    "canonicalize": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9"
  }
}
