                  "p50_ms": {
                    "exclusiveMinimum": 0,
                    "type": "integer",
                  },
                  "p99_ms": {
                    "exclusiveMinimum": 0,
                    "type": "integer",
                  },
                  "success_rate": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number",
                  },
                },
                "type": "object",
              },
            },
            "required": [
              "name",
              "input_schema",
              "output_schema",
