exports[`@agentagora/protocol JSON Schema wire-shape lock > CapabilitySchema (one capability entry) 1`] = `
{
  "$ref": "#/definitions/Capability",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "accepts": {
          "default": [],
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "description": {
          "type": "string",
        },
        "input_schema": {
          "additionalProperties": {},
          "type": "object",
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string",
        },
        "output_schema": {
          "additionalProperties": {},
          "type": "object",
        },
        "pricing": {
          "additionalProperties": false,
          "properties": {
            "amount": {
              "pattern": "^\\d+(\\.\\d+)?$",
              "type": "string",
            },
            "currency": {
              "minLength": 1,
              "type": "string",
            },
            "model": {
              "enum": [
                "free",
                "per_call",
                "per_token",
                "negotiated",
              ],
              "type": "string",
            },
          },
          "required": [
            "model",
          ],
          "type": "object",
        },
        "sla": {
          "additionalProperties": false,
          "default": {},
          "properties": {
            "p50_ms": {
              "exclusiveMinimum": 0,
              "type": "integer",
            },
            "p99_ms": {
              "exclusiveMinimum": 0,
              "type": "integer",
            },
            "success_rate": {
              "maximum": 1,
              "minimum": 0,
              "type": "number",
            },
          },
          "type": "object",
        },
      },
      "required": [
        "name",
        "input_schema",
        "output_schema",
        "pricing",
      ],
      "type": "object",
    },
  },
}
`;

