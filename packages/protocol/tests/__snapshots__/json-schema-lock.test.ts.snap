          "type": "string",
        },
        "manifest_version": {
          "const": 1,
          "type": "number",
        },
        "metadata": {
          "additionalProperties": true,
          "default": {},
          "properties": {
            "languages": {
              "default": [],
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "models_used": {
              "default": [],
              "items": {
