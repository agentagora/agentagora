{
  "name": "@agentagora/protocol",
  "version": "0.2.0",
  "description": "Wire types and Zod schemas for the AgentAgora Protocol (AAP). Single source of truth for protocol-level definitions.",
  "license": "Apache-2.0",
  "author": "AgentAgora maintainers",
  "homepage": "https://github.com/agentagora/agentagora/tree/main/packages/protocol#readme",
  "bugs": "https://github.com/agentagora/agentagora/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentagora/agentagora.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "import": "./dist/envelope.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./mandate": {
      "types": "./dist/mandate.d.ts",
      "import": "./dist/mandate.js"
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9",
    "zod-to-json-schema": "~3.23.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
