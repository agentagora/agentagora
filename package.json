{
  "name": "agentagora-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AgentAgora — open layer for agent-to-agent interop. Monorepo root.",
  "license": "Apache-2.0",
  "repository": "github:agentagora/agentagora",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9",
    "tsup": "^8.5.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
